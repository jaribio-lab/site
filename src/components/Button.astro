---
// Pill button or link. Use at most one primary button per section.
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'dark' | 'light';
  size?: 'md' | 'sm';
  arrow?: boolean;
  magnet?: boolean;
  external?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', arrow = false, magnet = true, external, type = 'button', class: cls, ...rest } = Astro.props;
const isExternal = external ?? (href?.startsWith('http') ?? false);
const Tag = href ? 'a' : 'button';
---
<Tag
  class:list={['btn', variant, size, cls]}
  href={href}
  type={href ? undefined : type}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener' : undefined}
  data-magnet={magnet ? '' : undefined}
  {...rest}
>
  <slot />
  {arrow && <span class="arr" aria-hidden="true">→</span>}
  {isExternal && !arrow && <span class="arr" aria-hidden="true">↗</span>}
</Tag>

<style>
  .btn {
    --mx: 0px; --my: 0px; --s: 1;
    display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
    font-family: var(--display); font-weight: 600; font-size: 16px;
    padding: 14px 26px; border-radius: var(--r-pill); border: 1.5px solid transparent; cursor: pointer;
    transform: translate(var(--mx), var(--my)) scale(var(--s));
    transition: transform .25s var(--spring), background .2s, border-color .2s, color .2s;
  }
  .btn.sm { font-size: 14px; padding: 9px 16px; }
  .btn:hover { --s: 1.04; }
  .btn:active { --s: .97; }
  .primary { background: var(--yellow); color: var(--dark); }
  .ghost { border-color: var(--line-strong); color: var(--ink); background: transparent; }
  .ghost:hover { border-color: var(--teal); }
  .dark { background: var(--dark); color: var(--ink); }
  .light { background: var(--white); color: var(--dark); }
  .arr { transition: transform .25s var(--spring); }
  .btn:hover .arr { transform: translateX(4px); }
</style>
