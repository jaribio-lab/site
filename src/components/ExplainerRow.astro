---
// One row in the Explained list. Fills with its color on hover and the icon animates.
import Shape from './Shape.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { explainer: CollectionEntry<'explained'> }
const { explainer } = Astro.props;
const e = explainer.data;
---
<a class="row reveal" href={`/explained/${explainer.id}`} style={`--c:var(--${e.color})`}>
  <span class="ico"><Shape kind={e.shape} color={e.color} size={56} /></span>
  <span class="txt"><b>{e.title}</b><small>{e.summary}</small></span>
  <span class="len">{e.status === 'published' && e.minutes ? `${e.minutes} min` : 'Soon'}</span>
  <span class="go" aria-hidden="true">→</span>
</a>

<style>
  .row {
    --shape-hole: var(--bg);
    position: relative; isolation: isolate; overflow: hidden;
    display: grid; grid-template-columns: 64px 1fr auto 32px; align-items: center; gap: 22px;
    padding: 22px 18px; border-bottom: 1px solid var(--line);
    transition: color .3s, padding .4s var(--ease);
  }
  .row::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--c); transform: scaleY(0); transform-origin: bottom; transition: transform .45s var(--ease); }
  .row:hover { --shape-hole: var(--c); color: var(--dark); padding-left: 28px; }
  .row:hover::before { transform: scaleY(1); }
  .ico { display: grid; place-items: center; transition: transform .45s var(--spring); }
  .row:hover .ico { transform: scale(1.1) rotate(-8deg); }
  .row:hover .ico :global(.inner) { animation: wiggle 1s ease-in-out infinite; }
  .row:hover .ico :global(.inner > :not([style*="fill:none"]):not([style*="shape-hole"])) { fill: var(--dark) !important; }
  .row:hover .ico :global(.inner > [style*="stroke"]:not([style*="shape-hole"])) { stroke: var(--dark) !important; }
  b { display: block; font-family: var(--display); font-weight: 800; font-size: clamp(20px, 2.4vw, 28px); letter-spacing: -.02em; line-height: 1.15; }
  small { font-size: 15px; color: var(--muted); transition: color .3s; }
  .row:hover small, .row:hover .len { color: rgba(20, 16, 34, .75); }
  .len { font-size: 13px; color: var(--muted); transition: color .3s; }
  .go { font-size: 22px; opacity: 0; transform: translateX(-8px); transition: transform .35s var(--spring), opacity .25s; }
  .row:hover .go { opacity: 1; transform: none; }
  @keyframes wiggle { 25% { transform: rotate(10deg) scale(1.05); } 75% { transform: rotate(-10deg) scale(1.05); } }
  @media (max-width: 600px) { .row { grid-template-columns: 52px 1fr; gap: 16px; } .len, .go { display: none; } }
</style>
