---
// One dot per training run: stages down the side, seeds across. Shows what has run so far.
import type { AccentName } from '../lib/brand';
interface Props {
  stages: { id: string; label: string; name: string; color: AccentName }[];
  seeds: number;
  runs: Record<string, { status: 'running' | 'done' | 'failed'; cost?: number }>;
}
const { stages, seeds, runs } = Astro.props;
const total = stages.length * seeds;
const done = Object.values(runs).filter(r => r.status === 'done').length;
const spent = Object.values(runs).reduce((a, r) => a + (r.cost ?? 0), 0);
---
<div class="rg reveal">
  <div class="top">
    <div><b data-count={done}>{done}</b><span>of {total} runs done</span></div>
    <div><b data-count={Math.round(spent)} data-prefix="$">${Math.round(spent)}</b><span>GPU spent so far</span></div>
    <div class="bar" aria-hidden="true"><span style={`width:${(done / total) * 100}%`}></span></div>
  </div>
  <div class="grid" style={`--seeds:${seeds}`}>
    <span></span>
    {Array.from({ length: seeds }, (_, i) => <span class="sh">Seed {i + 1}</span>)}
    {stages.map((s, r) => (
      <>
        <span class="sn" style={`--c:var(--${s.color})`} title={s.name}><b>{s.label}</b><span class="nm">{s.name}</span></span>
        {Array.from({ length: seeds }, (_, i) => {
          const run = runs[`${s.id}-${i + 1}`];
          const status = run?.status ?? 'queued';
          return (
            <span class:list={['run', status]} style={`--c:var(--${s.color});--d:${(r * seeds + i) * 40}ms`} title={`${s.name}, seed ${i + 1}: ${status}${run?.cost != null ? `, $${run.cost}` : ''}`}>
              <i></i><small>{status}</small>
            </span>
          );
        })}
      </>
    ))}
  </div>
</div>

<style>
  .rg { padding: 26px; border-radius: var(--r-lg); background: var(--panel); }
  .top { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16px 40px; margin-bottom: 24px; }
  .top div:not(.bar) { display: flex; flex-direction: column; font-size: 13px; color: var(--muted); }
  .top b { font-family: var(--display); font-size: 34px; line-height: 1; color: var(--ink); letter-spacing: -.03em; }
  .bar { flex: 1; min-width: 160px; height: 10px; margin-bottom: 6px; border-radius: var(--r-pill); background: var(--line-strong); overflow: hidden; }
  .bar span { display: block; height: 100%; border-radius: inherit; background: var(--teal); }
  .grid { display: grid; grid-template-columns: minmax(120px, 1.6fr) repeat(var(--seeds), minmax(0, 1fr)); gap: 8px; align-items: center; }
  .sh { font-size: 12px; color: var(--muted); text-align: center; }
  .sn { display: flex; align-items: center; gap: 10px; font-size: 14px; }
  .sn b { display: grid; place-items: center; flex: none; width: 26px; height: 26px; border-radius: 50%; background: var(--c); color: var(--dark); font-family: var(--display); font-size: 13px; }
  .run { display: flex; align-items: center; justify-content: center; gap: 8px; height: 40px; border-radius: 12px; background: var(--bg); font-size: 12px; color: var(--muted); }
  .run i { width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 2px var(--line-strong); transform: scale(0); }
  .rg.on .run i { transform: scale(1); transition: transform .4s var(--spring) var(--d); }
  .run.running i { background: var(--c); box-shadow: none; animation: pulse 1.4s ease-in-out infinite; }
  .run.done i { background: var(--c); box-shadow: none; }
  .run.failed i { background: transparent; box-shadow: inset 0 0 0 2px var(--coral); }
  .run.done small, .run.running small { color: var(--ink); }
  @keyframes pulse { 50% { transform: scale(1.35); } }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 34px repeat(var(--seeds), minmax(0, 1fr)); }
    .nm { display: none; }
    .run small { display: none; }
  }
</style>
