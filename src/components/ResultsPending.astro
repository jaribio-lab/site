---
// Placeholder for a results chart that has no data yet. Shows the chart's shape, never fake numbers.
interface Props { title: string; text?: string; kind?: 'bars' | 'lines' }
const { title, text, kind = 'bars' } = Astro.props;
---
<div class="rp reveal">
  <div class="ghost" aria-hidden="true">
    {kind === 'bars'
      ? [62, 40, 78, 30, 55, 70].map((h, i) => <span class="b" style={`--h:${h}%;--i:${i}`}></span>)
      : <svg viewBox="0 0 300 120" preserveAspectRatio="none"><path class="ln" d="M0 90 C 60 80, 90 30, 150 50 S 240 100, 300 40" /><path class="ln l2" d="M0 70 C 70 60, 110 90, 160 70 S 250 20, 300 30" /></svg>}
  </div>
  <div class="txt">
    <span class="tag"><i></i>Waiting for runs</span>
    <h4>{title}</h4>
    {text && <p>{text}</p>}
  </div>
</div>

<style>
  .rp { display: grid; grid-template-columns: 1fr 1.2fr; gap: 28px; align-items: center; padding: 24px; border: 2px dashed var(--line-strong); border-radius: var(--r-lg); }
  .ghost { display: flex; align-items: flex-end; gap: 8px; height: 140px; padding: 12px; border-radius: var(--r-md); background: var(--panel); overflow: hidden; }
  .b { flex: 1; height: var(--h); border-radius: 8px 8px 4px 4px; background: linear-gradient(90deg, var(--line) 0%, var(--line-strong) 50%, var(--line) 100%); background-size: 200% 100%; animation: shimmer 2.2s linear infinite; animation-delay: calc(var(--i) * 120ms); }
  svg { width: 100%; height: 100%; }
  .ln { fill: none; stroke: var(--line-strong); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 8 10; animation: dash 3s linear infinite; }
  .l2 { stroke: var(--line); }
  .tag { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .tag i { width: 8px; height: 8px; border-radius: 50%; background: var(--yellow); animation: blink 1.6s ease-in-out infinite; }
  h4 { margin-bottom: 6px; }
  p { color: var(--text-2); font-size: 15px; }
  @keyframes shimmer { to { background-position: -200% 0; } }
  @keyframes dash { to { stroke-dashoffset: -36; } }
  @keyframes blink { 50% { opacity: .3; } }
  @media (max-width: 680px) { .rp { grid-template-columns: 1fr; } .ghost { height: 100px; } }
</style>
