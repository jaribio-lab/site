---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Shape from '../../components/Shape.astro';
import Button from '../../components/Button.astro';
import ExplainerRow from '../../components/ExplainerRow.astro';
import { links } from '../../lib/brand';

export async function getStaticPaths() {
  const all = (await getCollection('explained')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: all[i + 1] ?? all[0] } }));
}

const { entry, next } = Astro.props;
const e = entry.data;
const { Content } = await render(entry);
---
<BaseLayout title={e.title} description={e.summary}>
  <section class="hero wrap" style={`--c:var(--${e.color})`}>
    <a class="back" href="/explained">← All explainers</a>
    <div class="stage">
      <Shape kind={e.shape} color={e.color} size={200} motion={e.motion} />
      <span class="orbit o1"><Shape kind="dot" color="ink" size={18} /></span>
      <span class="orbit o2"><Shape kind="dot" color={e.color} size={12} /></span>
    </div>
    <p class="ep">Explained · Episode {String(e.order).padStart(2, '0')}</p>
    <h1>{e.title}</h1>
    <p class="lede">{e.summary}</p>
  </section>

  <section class="wrap video-sec">
    {e.video ? (
      <div class="video reveal"><iframe src={e.video} title={e.title} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe></div>
    ) : (
      <div class="soon reveal">
        <Shape kind="face" color={e.color} size={90} motion="bob" />
        <div>
          <h3>This episode is being animated.</h3>
          <p>Subscribe and you'll see it the day it lands.</p>
        </div>
        <Button href={links.youtube}>Subscribe</Button>
      </div>
    )}
  </section>

  <section class="wrap">
    <article class="prose reveal"><Content /></article>
  </section>

  <section class="wrap">
    <p class="next-k">Up next</p>
    <div class="list"><ExplainerRow explainer={next} /></div>
  </section>
</BaseLayout>

<style>
  .hero { --shape-hole: var(--bg); padding-block: 30px; text-align: center; overflow-x: clip; }
  .back { display: inline-block; font-size: 14px; color: var(--muted); transition: color .2s; }
  .back:hover { color: var(--ink); }
  .stage { position: relative; width: 260px; height: 260px; margin: 20px auto; display: grid; place-items: center; animation: pop .9s var(--spring) both; }
  .orbit { position: absolute; inset: 0; animation: orbit 9s linear infinite; }
  .orbit :global(svg) { position: absolute; left: 50%; top: 0; }
  .o2 { animation-duration: 6s; animation-direction: reverse; inset: 30px; }
  .ep { font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--c); }
  h1 { margin-top: 8px; }
  .lede { margin: 16px auto 0; }
  .video-sec { padding-block: 30px; }
  .video { overflow: hidden; aspect-ratio: 16 / 9; border-radius: var(--r-lg); background: var(--panel); }
  .video iframe { width: 100%; height: 100%; border: 0; }
  .soon { --shape-hole: var(--panel); display: flex; align-items: center; gap: 24px; flex-wrap: wrap; padding: 30px; border-radius: var(--r-lg); background: var(--panel); }
  .soon > div { flex: 1; min-width: 200px; }
  .soon p { color: var(--text-2); }
  .prose { margin-inline: auto; font-size: 20px; }
  .next-k { margin-bottom: 12px; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .list { border-top: 1px solid var(--line); }
  @keyframes orbit { to { transform: rotate(360deg); } }
  @keyframes pop { from { opacity: 0; transform: scale(.4) rotate(-40deg); } }
</style>
