---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Shape from '../../components/Shape.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Stat from '../../components/Stat.astro';
import Tag from '../../components/Tag.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ReportNav from '../../components/ReportNav.astro';
import StageExplorer from '../../components/StageExplorer.astro';
import StepCard from '../../components/StepCard.astro';
import RunGrid from '../../components/RunGrid.astro';
import ResultBars from '../../components/ResultBars.astro';
import ResultsPending from '../../components/ResultsPending.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import WrongAnswersDemo from '../../components/demos/WrongAnswersDemo.astro';
import { links } from '../../lib/brand';

export async function getStaticPaths() {
  const all = await getCollection('experiments');
  return all.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const e = entry.data;
const { Content } = await render(entry);
const date = e.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const staged = e.stages.length > 0;
const words = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'];
const stageCount = e.stages.filter(s => s.id !== 'control').length;
const hasControl = e.stages.some(s => s.id === 'control');
const unseen = e.fields.filter(f => f.unseen).map(f => f.label.toLowerCase());

const nav = [
  { id: 'overview', label: 'Overview' },
  ...(staged ? [{ id: 'stages', label: 'Stages' }] : []),
  ...(e.measures.length ? [{ id: 'measures', label: 'What we measure' }] : []),
  ...(staged ? [{ id: 'runs', label: 'Runs' }] : []),
  { id: 'results', label: 'Results' },
  { id: 'background', label: 'Background' },
];
---
<BaseLayout title={`${e.number} · ${e.title}`} description={e.summary}>
  <section class="hero wrap" style={`--c:var(--${e.color})`}>
    <div class="art">
      <span class="num">{e.number}</span>
      <Shape kind={e.shape} color="dark" size={240} motion="float" transitionName={`exp-${e.number}`} class="big" />
    </div>
    <div class="head">
      <a class="back" href="/experiments">← All experiments</a>
      <p class="title">Experiment {e.number} · {e.title}</p>
      <h1>{e.question}</h1>
      <p class="lede">{e.summary}</p>
      <div class="meta">
        <StatusBadge status={e.status} />
        <span>{date}</span>
        {e.models.map(m => <span>{m}</span>)}
      </div>
    </div>
  </section>

  <ReportNav items={nav} />

  <section class="wrap block" id="overview">
    <div class="facts reveal">
      {e.cost != null ? <Stat value={e.cost} prefix="$" label="GPU spent" size="lg" /> : <Stat value={e.budget} prefix="$" label="GPU budget" size="lg" />}
      {e.facts.map(f => <Stat value={f.value} prefix={f.prefix} label={f.label} size="lg" />)}
      {e.seeds > 1 && <Stat value={e.seeds} label="seeds per setup" size="lg" />}
    </div>
    <div class="tags">
      {e.links.video && <Tag href={e.links.video}>Watch the video</Tag>}
      {e.links.code && <Tag href={e.links.code}>Code</Tag>}
      {e.links.dataset && <Tag href={e.links.dataset}>Dataset</Tag>}
      {e.links.model && <Tag href={e.links.model}>Model</Tag>}
      {e.tags.map(t => <Tag>#{t}</Tag>)}
    </div>
    {e.demo === 'wrong-answers' && <div class="demo reveal"><WrongAnswersDemo /></div>}
  </section>

  {staged && (
    <section class="wrap block" id="stages">
      <SectionHeader
        kicker="The stages"
        title={`${words[stageCount] ?? stageCount} stage${stageCount === 1 ? '' : 's'}${hasControl ? ' and a control' : ''}.`}
        lede={`Click a stage to see what the model is trained on and an example conversation.${unseen.length ? ` Rows at the bottom, ${unseen.join(', ')}, never appear in training. They're only tested.` : ''}`}
      />
      <StageExplorer fields={e.fields} stages={e.stages} />
    </section>
  )}

  {e.measures.length > 0 && (
    <section class="wrap block" id="measures">
      <SectionHeader kicker="What we measure" title="Measured in every subject, after every stage." />
      <div class="measures">
        {e.measures.map(m => <StepCard title={m.title} shape={m.shape} color={m.color}>{m.text}</StepCard>)}
      </div>
    </section>
  )}

  {staged && (
    <section class="wrap block" id="runs">
      <SectionHeader kicker="Runs" title="Every training run, as it happens." lede="One dot per run. They fill in as runs finish, with the GPU cost of each." />
      <RunGrid stages={e.stages} seeds={e.seeds} runs={e.runs} />
    </section>
  )}

  <section class="wrap block" id="results">
    <SectionHeader kicker="Results" title={e.results.length ? 'What we found.' : 'Charts land here when the runs finish.'} />
    {e.results.length > 0 ? (
      <ResultBars rows={e.results} beforeLabel="Control" afterLabel="After" />
    ) : (
      <div class="pending">
        {(e.measures.length ? e.measures : [{ title: 'Headline result', text: '' }]).map((m, i) => (
          <ResultsPending title={m.title} text={m.text} kind={i % 2 ? 'lines' : 'bars'} />
        ))}
      </div>
    )}
  </section>

  <section class="wrap block" id="background">
    <SectionHeader kicker="Background" title="How we keep it honest." />
    <article class="prose reveal"><Content /></article>
  </section>

  <section class="wrap">
    <CtaBlock title="Think we got something wrong?" text="Rerun it, then tell us. Corrections get credited in the next video." href={links.discussions} label="Open a discussion" color={e.color} />
  </section>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: 1fr 1.3fr; gap: 40px; align-items: center; padding-block: 30px 40px; }
  .art { --shape-hole: var(--c); position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 36px; background: var(--c); color: var(--dark); animation: grow .9s var(--spring) both; }
  .num { position: absolute; left: 26px; bottom: 14px; font-family: var(--display); font-weight: 800; font-size: clamp(80px, 12vw, 150px); line-height: 1; letter-spacing: -.06em; }
  .art :global(.big) { position: absolute; right: -30px; top: -30px; }
  .back { display: inline-block; margin-bottom: 20px; font-size: 14px; color: var(--muted); transition: color .2s, transform .25s var(--spring); }
  .back:hover { color: var(--ink); transform: translateX(-4px); }
  .title { margin-bottom: 10px; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  h1 { font-size: clamp(34px, 4.6vw, 58px); }
  .head > * { animation: rise .8s var(--ease) both; }
  .head > *:nth-child(2) { animation-delay: .06s; }
  .head > *:nth-child(3) { animation-delay: .12s; }
  .head > *:nth-child(4) { animation-delay: .18s; }
  .head > *:nth-child(5) { animation-delay: .24s; }
  .lede { margin-top: 18px; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 22px; font-size: 14px; color: var(--muted); }
  .block { scroll-margin-top: 70px; }
  #overview { padding-top: 40px; }
  .facts { display: flex; flex-wrap: wrap; gap: 30px 56px; padding-block: 30px; border-block: 1px solid var(--line); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .demo { margin-top: 40px; overflow: hidden; border-radius: 30px; }
  .measures { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; }
  .pending { display: grid; gap: 16px; }
  .prose { margin-inline: 0; }
  .prose :global(h2:first-child) { margin-top: 0; }
  @keyframes grow { from { opacity: 0; transform: scale(.85) rotate(-4deg); } }
  @keyframes rise { from { opacity: 0; transform: translateY(26px); } }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    .art { max-width: 340px; }
  }
</style>
